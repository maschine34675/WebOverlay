<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{9B41D0E7-5A62-4C39-8D71-63F0A2C48E19}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>WebOverlay</RootNamespace>
    <AssemblyName>Anvil-WebOverlayDemo</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <!-- Relative to the working copy, see WebOverlay.csproj. Overridable with /p:SptRoot=... -->
    <SptRoot Condition="'$(SptRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..</SptRoot>
    <DeployToSpt Condition="'$(DeployToSpt)' == ''">true</DeployToSpt>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <Reference Include="BepInEx">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\WebOverlay\WebOverlay.csproj">
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DemoPlugin.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Three.js cube demo: page plus bundled library (MIT, see
         web\three-LICENSE.txt), spliced together at runtime. -->
    <EmbeddedResource Include="web\cube.html">
      <LogicalName>WebOverlay.Demo.cube.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\three.min.js">
      <LogicalName>WebOverlay.Demo.three.min.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="DeployToSpt" AfterTargets="Build" Condition="'$(DeployToSpt)' == 'true'">
    <Error Condition="'$(SptRoot)' == ''" Text="Set SptRoot when DeployToSpt=true." />
    <!-- Only deploy into a real SPT install, see WebOverlay.csproj. -->
    <Message Condition="!Exists('$(SptRoot)\BepInEx\core\BepInEx.dll')" Importance="high"
             Text="Skipping deploy: $(SptRoot) is not an SPT installation (BepInEx\core\BepInEx.dll not found). Set /p:SptRoot=&lt;your SPT folder&gt;." />
    <PropertyGroup>
      <PluginDirectory>$(SptRoot)\BepInEx\plugins\$(AssemblyName)</PluginDirectory>
    </PropertyGroup>
    <MakeDir Condition="Exists('$(SptRoot)\BepInEx\core\BepInEx.dll')" Directories="$(PluginDirectory)" />
    <Copy Condition="Exists('$(SptRoot)\BepInEx\core\BepInEx.dll')" SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDirectory)" />
  </Target>
</Project>
